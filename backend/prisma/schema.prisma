generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  citizen
  government
  admin
}

enum ReportStatus {
  submitted
  analyzing
  verified
  assigned
  in_progress
  resolved
  rejected
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProjectStatus {
  planned
  in_progress
  completed
}

enum ReviewStatus {
  pending_review
  approved
  rejected
}

enum AuditType {
  system
  user
  ai
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reports         CitizenReport[]
  notifications   Notification[]
  auditEvents     AuditEvent[]    @relation("AuditActor")
  reviewedRecs    Recommendation[] @relation("RecommendationReviewer")

  @@index([role])
  @@index([email])
}

model CitizenReport {
  id          String       @id @default(uuid())
  userId      String
  title       String
  description String
  category    String
  address     String
  district    String
  latitude    Float
  longitude   Float
  status      ReportStatus @default(submitted)
  severity    Severity?
  urgency     Severity?
  aiSummary   String?
  aiCategory  String?
  aiConfidence Float?
  aiReasoning String?
  recommendedAction String?
  aiMode      String       @default("demo")
  aiFailed    Boolean      @default(false)
  audioUrl    String?
  hotspotId   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotspot Hotspot?       @relation(fields: [hotspotId], references: [id])
  images  ReportImage[]
  audits  AuditEvent[]
  notifications Notification[]

  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([severity])
  @@index([urgency])
  @@index([createdAt])
  @@index([hotspotId])
  @@index([district])
  @@index([latitude, longitude])
}

model ReportImage {
  id        String   @id @default(uuid())
  reportId  String
  fileId    String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  report CitizenReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  file   StoredFile    @relation(fields: [fileId], references: [id])

  @@index([reportId])
}

model StoredFile {
  id           String   @id @default(uuid())
  storageKey   String   @unique
  originalName String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  images ReportImage[]
}

model Hotspot {
  id                 String   @id @default(uuid())
  category           String
  address            String
  district           String
  latitude           Float
  longitude          Float
  gridKey            String   @unique
  reportCount        Int      @default(0)
  trendPercentage    Int      @default(0)
  severity           Severity @default(MEDIUM)
  populationAffected Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  reports     CitizenReport[]
  predictions Prediction[]

  @@index([category])
  @@index([severity])
  @@index([district])
}

model Prediction {
  id                   String   @id @default(uuid())
  title                String
  category             String
  address              String
  district             String
  latitude             Float
  longitude            Float
  riskLevel            Severity
  trend                String
  timeHorizon          String
  confidence           Int
  recommendedAction    String
  contributingFactors  String[]
  sourceLabel          String   @default("DEMO / ANALYTICAL ESTIMATE")
  hotspotId            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  hotspot  Hotspot?        @relation(fields: [hotspotId], references: [id])
  evidence EvidenceItem[]
  audits   AuditEvent[]

  @@index([riskLevel])
  @@index([category])
  @@index([createdAt])
}

model Project {
  id          String        @id @default(uuid())
  title       String
  description String
  status      ProjectStatus @default(planned)
  budget      Float
  address     String
  district    String
  latitude    Float
  longitude   Float
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  recommendations Recommendation[]
}

model Recommendation {
  id               String       @id @default(uuid())
  title            String
  address          String
  district         String
  latitude         Float
  longitude        Float
  priorityScore    Int
  estimatedCost    Float
  populationImpact Int
  urgency          Severity
  expectedImpact   Severity
  reviewStatus     ReviewStatus @default(pending_review)
  projectId        String?
  reviewedById     String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  project    Project?      @relation(fields: [projectId], references: [id])
  reviewedBy User?         @relation("RecommendationReviewer", fields: [reviewedById], references: [id])
  evidence   Evidence?
  audits     AuditEvent[]

  @@index([priorityScore])
  @@index([reviewStatus])
}

model Evidence {
  id                      String   @id @default(uuid())
  recommendationId        String   @unique
  reportCount             Int
  trendPercentage         Int
  infrastructureGap       Severity
  populationImpact        Int
  urgency                 Severity
  demand                  Int
  severityScore           Int
  urgencyScore            Int
  populationImpactScore   Int
  costEfficiency          Int
  calculationMethodology  String
  confidence              Int
  dataSources             String[]
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  items          EvidenceItem[]
}

model EvidenceItem {
  id           String   @id @default(uuid())
  evidenceId   String?
  predictionId String?
  sourceType   String
  metric       String
  value        String
  timestamp    DateTime @default(now())
  calculation  String
  limitations  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  evidence   Evidence?   @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  prediction Prediction? @relation(fields: [predictionId], references: [id], onDelete: Cascade)

  @@index([evidenceId])
  @@index([predictionId])
}

model AuditEvent {
  id               String    @id @default(uuid())
  timestamp        DateTime  @default(now())
  action           String
  actorName        String
  actorId          String?
  details          String
  type             AuditType
  reportId         String?
  recommendationId String?
  predictionId     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  actor          User?           @relation("AuditActor", fields: [actorId], references: [id])
  report         CitizenReport?  @relation(fields: [reportId], references: [id], onDelete: SetNull)
  recommendation Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  prediction     Prediction?     @relation(fields: [predictionId], references: [id], onDelete: SetNull)

  @@index([timestamp])
  @@index([type])
  @@index([actorId])
  @@index([reportId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  reportId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  report CitizenReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([userId, read])
  @@index([createdAt])
}
